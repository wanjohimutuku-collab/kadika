# Settings for ./scripts/deploy.sh (deploying without GitHub Actions). Copy to .deploy.env, which is gitignored.

# GHCR login. A GitHub personal access token with the write:packages scope (classic), owned by someone
# with write access to the repository's packages.
GHCR_USER=your-github-username
GHCR_TOKEN=ghp_xxx

# Same values as the GitHub "staging" environment variables (infra/coolify/README.md).
NEXT_PUBLIC_API_URL=https://api.staging.kadisasa.com
NEXT_PUBLIC_APP_DOMAIN=staging.kadisasa.com
NEXT_PUBLIC_SITE_URL=https://staging.kadisasa.com
NEXT_PUBLIC_KENYA_ENABLED=0
# Where the web app's /api/health is reachable (defaults to NEXT_PUBLIC_SITE_URL).
DEPLOY_WEB_URL=

# Production values: the same names with a _PRODUCTION suffix take over for `deploy.sh production`.
# NEXT_PUBLIC_API_URL_PRODUCTION=https://api.kadisasa.com
# NEXT_PUBLIC_APP_DOMAIN_PRODUCTION=kadisasa.com
# NEXT_PUBLIC_SITE_URL_PRODUCTION=https://kadisasa.com
# NEXT_PUBLIC_KENYA_ENABLED_PRODUCTION=0
