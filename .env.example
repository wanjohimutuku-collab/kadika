# --- Core ---
DATABASE_URL=postgres://harusi:harusi@localhost:5432/harusi
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-dev-only
# 32-byte key, base64 (AES-GCM for signing keys). Generate: openssl rand -base64 32
KEY_ENC_SECRET=change-me-dev-only
APP_BASE_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the API (defaults to APP_BASE_URL)
CORS_ORIGINS=http://localhost:3000
# Web app → API (used when NEXT_PUBLIC_USE_MOCKS=0)
NEXT_PUBLIC_API_URL=http://localhost:3001
SHORT_BASE_URL=http://localhost:3000
SENTRY_DSN=

# --- Object storage (SeaweedFS S3 locally; R2 in prod) ---
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=harusi
S3_ACCESS_KEY=dev
S3_SECRET_KEY=dev

# --- WhatsApp: choose ONE provider with WHATSAPP_PROVIDER = fake | evolution | cloud ---
WHATSAPP_PROVIDER=fake
# evolution: self-hosted Evolution API v2 (unofficial WhatsApp Web protocol)
EVOLUTION_BASE_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
# cloud: official WhatsApp Business Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v21.0
# Webhook handshake token you type into the Meta app, and the app secret used to verify signatures
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Names of the APPROVED message templates (see docs/adr/020-whatsapp-two-providers.md)
WHATSAPP_TEMPLATE_INVITE=
WHATSAPP_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_PLEDGE=
# Hours a WhatsApp invitation may stay undelivered before the SMS fallback
WHATSAPP_FALLBACK_HOURS=6

# --- SMS (provider adapter: fake | nextsms) ---
SMS_PROVIDER=fake
NEXTSMS_USERNAME=
NEXTSMS_PASSWORD=
# Alphanumeric sender id registered with NextSMS / TCRA
SMS_SENDER_ID=

# --- Delivery webhooks: send this in the `x-webhook-secret` header (Evolution webhook headers) ---
WEBHOOK_SECRET=

# --- Payments (provider adapter: fake | selcom | azampay | clickpesa) ---
PAYMENT_PROVIDER=fake
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Ports (not in §11; used by dev servers) ---
API_PORT=3001

# Local dev only: print OTP SMS bodies to the API log (never enable in production)
DEV_LOG_OTP=0

# One JSON log line per request (route pattern only, never tokens). Set 0 to silence.
LOG_REQUESTS=1

# --- Kenya support (ADR 025, docs/plan/kenya-product-support.md) ---
# Off by default: only +255 numbers, TZS and Tanzanian events. Turn all three on together.
KENYA_ENABLED=0
NEXT_PUBLIC_KENYA_ENABLED=0
EXPO_PUBLIC_KENYA_ENABLED=0

# --- Kenya messaging (ADR 026); used only when KENYA_ENABLED is on ---
# SMS route for +254 numbers: fake | africastalking
SMS_PROVIDER_KE=fake
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Sandbox: https://api.sandbox.africastalking.com
AT_BASE_URL=
# Link domain in Kenyan messages (defaults to SHORT_BASE_URL)
SHORT_BASE_URL_KE=
# WhatsApp templates approved for Kenya (one host field; see docs/ops/whatsapp-templates-kenya.md)
WHATSAPP_TEMPLATE_INVITE_KE=
WHATSAPP_TEMPLATE_REMINDER_KE=
WHATSAPP_TEMPLATE_PLEDGE_KE=
# Africa's Talking delivery reports: POST https://<api>/v1/webhooks/sms/africastalking?secret=<WEBHOOK_SECRET>

# --- Kenya payments (ADR 027); used only when KENYA_ENABLED is on ---
# Mobile-money route for Kenyan events: fake | aggregator
PAYMENT_PROVIDER_KE=fake
# fake: PAYMENT_WEBHOOK_SECRET_KE (falls back to PAYMENT_WEBHOOK_SECRET). aggregator: all four below.
PAYMENT_API_URL_KE=
PAYMENT_API_KEY_KE=
PAYMENT_WEBHOOK_SECRET_KE=
# Public HTTPS URL the aggregator calls: https://<api>/v1/payments/webhook/aggregator-ke
PAYMENT_CALLBACK_URL_KE=

# --- Kenya rollback levers (docs/ops/kenya-pilot-runbook.md, section 5) ---
# Pause new Kenyan messages / new Kenyan payment prompts without turning Kenya off. Restart the API.
KENYA_SENDING_PAUSED=0
KENYA_PAYMENTS_PAUSED=0
