      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 16px;border:none;border-radius:var(--hp-radius-input,8px);background:var(--hp-primary,#0F5C4D);color:var(--hp-on-primary,#fff);font:600 16px/1 system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;cursor:pointer;transition:background-color .15s ease-out}.ds-btn-primary:hover{background:color-mix(in srgb,var(--hp-primary,#0F5C4D) 90%,#fff)}.ds-btn-primary:active{background:color-mix(in srgb,var(--hp-primary,#0F5C4D) 80%,#fff)}.ds-btn-primary:focus-visible{outline:3px solid var(--hp-primary,#0F5C4D);outline-offset:2px}"
