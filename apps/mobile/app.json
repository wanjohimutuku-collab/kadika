{
  "expo": {
    "name": "Kadi Sasa",
    "slug": "harusi-pass",
    "version": "0.6.0",
    "scheme": "harusipass",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/adaptive-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF8F3"
    },
    "android": {
      "package": "app.harusipass.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF8F3"
      },
      "permissions": []
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Kadi Sasa inahitaji kamera kuskani QR za kadi."
        }
      ],
      "expo-sqlite",
      "expo-audio"
    ],
    "experiments": {},
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
