{
  "expo": {
    "name": "Harusi Pass",
    "slug": "harusi-pass",
    "version": "0.0.0",
    "scheme": "harusipass",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "app.harusipass.mobile",
      "permissions": []
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Harusi Pass inahitaji kamera kuskani QR za kadi."
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {},
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
