{
  "expo": {
    "name": "Kadi Sasa",
    "slug": "harusi-pass",
    "version": "0.0.0",
    "scheme": "harusipass",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "app.harusipass.mobile",
      "permissions": []
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Kadi Sasa inahitaji kamera kuskani QR za kadi."
        }
      ],
      "expo-sqlite",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kadi Sasa inahitaji picha zako ili uweke kumbukumbu za harusi.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {},
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
