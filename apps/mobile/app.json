{
  "expo": {
    "name": "Kadi Sasa",
    "slug": "harusi-pass",
    "version": "0.6.0",
    "scheme": "harusipass",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/adaptive-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF8F3"
    },
    "android": {
      "package": "app.harusipass.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF8F3"
      },
      "permissions": [],
      "blockedPermissions": ["android.permission.WRITE_CONTACTS"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Kadi Sasa inahitaji kamera kuskani QR za kadi."
        }
      ],
      "expo-sqlite",
      [
        "expo-contacts",
        {
          "contactsPermission": "Kadi Sasa inasoma majina na namba za simu unazochagua ili uwaongeze kama wageni. Hazitumwi popote mpaka uthibitishe."
        }
      ],
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kadi Sasa inahitaji picha zako ili uweke kumbukumbu za harusi.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {},
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
