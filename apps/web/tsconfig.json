{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": false,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "*.ts",
    ".next-prod/types/**/*.ts",
    ".next/types/**/*.ts",
    ".storybook",
    "app",
    "e2e",
    "next-env.d.ts",
    "next.config.ts",
    "src",
    ".next-live/types/**/*.ts"
  ],
  "exclude": ["node_modules", "storybook-static", ".next-prod"]
}
