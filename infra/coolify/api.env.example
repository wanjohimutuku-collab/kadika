# Production settings for the `api` application in Coolify, for kadisasa.com.
#
# Paste these into the application's Environment variables and replace every CHANGE_ME. The values that
# are not secret are already filled in for kadisasa.com. Keep the real secrets in Coolify only and never
# commit them. The full list, with the development defaults, is in /.env.example.
#
# The web application needs no runtime settings: its NEXT_PUBLIC_* values are baked in when the image is
# built (see infra/coolify/README.md).

# --- Required: the API will not start without these three -----------------------------------------------
# From the Postgres service you create in Coolify (use its internal connection string).
DATABASE_URL=CHANGE_ME
# Generate each of these yourself, for example:  openssl rand -base64 48   and   openssl rand -base64 32
# In production the API refuses a value that starts with "change-me". Back KEY_ENC_SECRET up: it encrypts
# the signing keys stored for each event, so losing or changing it makes those keys unreadable.
JWT_SECRET=CHANGE_ME
KEY_ENC_SECRET=CHANGE_ME

# --- Hostnames ------------------------------------------------------------------------------------------
# Browser origins allowed to call the API: all four web hosts.
CORS_ORIGINS=https://kadisasa.com,https://www.kadisasa.com,https://app.kadisasa.com,https://my.kadisasa.com
# Card links in SMS and WhatsApp messages open on the public host.
SHORT_BASE_URL=https://kadisasa.com
# Used for the gate-join link and as the default allowed origin.
APP_BASE_URL=https://app.kadisasa.com

# --- SMS: needed before anyone can sign in -------------------------------------------------------------
# Sign-in codes are sent by SMS. With SMS_PROVIDER=fake nothing is delivered, so nobody can sign in.
SMS_PROVIDER=nextsms
NEXTSMS_USERNAME=CHANGE_ME
NEXTSMS_PASSWORD=CHANGE_ME
# The alphanumeric sender id registered with NextSMS / TCRA.
SMS_SENDER_ID=CHANGE_ME

# --- Providers that can stay on "fake" for a first deploy (nothing real is sent or charged) --------------
# Switch them one at a time, after the matching accounts exist. See docs/adr/020-whatsapp-two-providers.md.
WHATSAPP_PROVIDER=fake
PAYMENT_PROVIDER=fake

# --- Object storage (Cloudflare R2 or another S3-compatible service) ------------------------------------
S3_ENDPOINT=CHANGE_ME
S3_REGION=auto
S3_BUCKET=CHANGE_ME
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# --- Webhooks (send this in the `x-webhook-secret` header) ----------------------------------------------
WEBHOOK_SECRET=CHANGE_ME

# --- Only if you run the background worker (reminders, queued sends) -------------------------------------
# REDIS_URL=redis://CHANGE_ME:6379

# --- Optional -------------------------------------------------------------------------------------------
# SENTRY_DSN=
LOG_REQUESTS=1

# --- Leave exactly like this in production --------------------------------------------------------------
# Printing sign-in codes in the log is for local development only.
DEV_LOG_OTP=0
# Kenya support stays off until it is wanted (docs/plan/kenya-product-support.md).
KENYA_ENABLED=0
API_PORT=3001
