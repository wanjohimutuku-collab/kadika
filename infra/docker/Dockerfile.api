# syntax=docker/dockerfile:1
# Build from the repo root: docker build -f infra/docker/Dockerfile.api .
FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /repo

FROM base AS build
COPY . .
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter @harusi/api...
RUN pnpm --filter @harusi/api build
# Production-only node_modules for the API (workspace deps are bundled by tsup).
RUN pnpm --filter @harusi/api deploy --prod /out

FROM node:22-alpine AS runtime
ENV NODE_ENV=production API_PORT=3001
WORKDIR /app
COPY --from=build --chown=node:node /out/node_modules ./node_modules
COPY --from=build --chown=node:node /repo/apps/api/dist ./dist
COPY --from=build --chown=node:node /repo/packages/db/drizzle ./drizzle
ENV MIGRATIONS_DIR=/app/drizzle
USER node
EXPOSE 3001
HEALTHCHECK --interval=15s --timeout=3s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+process.env.API_PORT+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
# Release step: migrations run before the API starts (single API instance; §11).
CMD ["sh", "-c", "node dist/migrate.js && exec node dist/index.js"]
