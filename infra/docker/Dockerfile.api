# syntax=docker/dockerfile:1
# Build from the repo root: docker build -f infra/docker/Dockerfile.api .
FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS base
ENV CI=true npm_config_store_dir=/pnpm/store
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /repo

# Only the files that decide what gets installed, gathered from the whole context so a new workspace
# package needs no edit here. BuildKit compares this by content, so the install layer below is
# reused (from the GitHub Actions cache) until a package.json, the lockfile or .npmrc changes.
FROM base AS manifests
COPY . .
RUN for f in $(find . -name node_modules -prune -o \( -name package.json -o -name pnpm-lock.yaml \
      -o -name pnpm-workspace.yaml -o -name .npmrc \) -print); do \
      mkdir -p "/m/$(dirname "$f")" && cp "$f" "/m/$f"; done

FROM base AS deps
COPY --from=manifests /m/ ./
# The repo uses node-linker=hoisted for Expo, which installs the whole workspace (~1400 packages).
# The API only needs its own tree, so the image uses the isolated linker.
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter @harusi/api... --config.node-linker=isolated

# Production-only node_modules for the API (workspace deps are bundled by tsup). Built from the manifests
# alone, so this image layer, about 94 MB, stays the same until a dependency changes: a release neither
# uploads it nor makes the server pull it again.
FROM deps AS prod-deps
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm --filter @harusi/api deploy --prod --prefer-offline --config.node-linker=isolated /out

# Only what the API is built from, so a change elsewhere (the web app, docs) reuses this build. A new
# workspace package the API uses goes here too; the build fails until it does.
FROM deps AS build
COPY tsconfig.base.json ./
COPY apps/api apps/api
COPY packages/api-client packages/api-client
COPY packages/crypto packages/crypto
COPY packages/db packages/db
COPY packages/gate packages/gate
COPY packages/messaging packages/messaging
COPY packages/payments packages/payments
COPY packages/schemas packages/schemas
COPY packages/ui-tokens packages/ui-tokens
RUN pnpm --filter @harusi/api build

FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS runtime
ENV NODE_ENV=production API_PORT=3001
WORKDIR /app
COPY --from=prod-deps --chown=node:node /out/node_modules ./node_modules
COPY --from=build --chown=node:node /repo/apps/api/dist ./dist
COPY --from=build --chown=node:node /repo/packages/db/drizzle ./drizzle
ENV MIGRATIONS_DIR=/app/drizzle
# Staff-uploaded app files (the Android APK, ADR 047) live on a volume mounted here; a named volume
# copies this folder's owner on first use, so the API (user node) can write to it.
RUN mkdir -p /data/app-files && chown node:node /data/app-files
ENV APP_FILES_DIR=/data/app-files
# Kumbukumbu photos (ADR 050): same arrangement, on their own volume.
RUN mkdir -p /data/photo-files && chown node:node /data/photo-files
ENV PHOTO_FILES_DIR=/data/photo-files
# The commit this image was built from, reported by /health so a deploy can be confirmed (ADR 035).
# Set last so it never invalidates the build layers above.
ARG GIT_SHA=dev
ENV GIT_SHA=$GIT_SHA
USER node
EXPOSE 3001
# --start-interval: check every 2s while starting, so the stack sees "healthy" soon after it is true and
# the web app, which waits for this, starts sooner. Docker before 25 ignores it and uses --interval.
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --start-interval=2s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+process.env.API_PORT+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
# Release step (run before start): node dist/migrate.js
CMD ["node", "dist/index.js"]
