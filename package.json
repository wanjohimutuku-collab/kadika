{
  "name": "harusi-pass",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @harusi/db generate",
    "db:migrate": "pnpm --filter @harusi/db migrate",
    "db:seed": "pnpm --filter @harusi/db seed",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "pnpm": {
    "overrides": {
      "node-forge@<1.4.3": "^1.4.3",
      "@expo/cli>undici": "^6.29.1",
      "@expo/server>undici": "^7.30.1",
      "postcss@<8.5.23": "^8.5.30",
      "@grpc/grpc-js@<1.13.6": "^1.13.6"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mrhx-c7xc-m3w5",
        "GHSA-qr28-fpjm-wq7f",
        "GHSA-5p2g-fcmc-qvqq",
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-86w9-cpqp-85rv"
      ]
    }
  }
}
